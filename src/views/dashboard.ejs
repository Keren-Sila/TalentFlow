<%- include('partials/header') %>

<%
  const pad2 = (n) => String(n ?? 0).padStart(2, '0');
  const dataHojeFormatada = new Date().toLocaleDateString('pt-BR', {
    day: 'numeric',
    month: 'long'
  });

  // Paleta de cores pastéis dos avatares exatamente como na referência
  const coresAvatares = [
    'avatar-lavender',
    'avatar-mint',
    'avatar-coral',
    'avatar-yellow',
    'avatar-blue',
    'avatar-lilac',
    'avatar-green',
    'avatar-orange'
  ];

  // Constrói lista de 8 pessoas combinando instrutores reais do banco + integrantes do time
  const instrutoresBanco = (indicadores.todosTreinamentos || []).map((t) => ({
    nome: t.instrutor.replace(/^(Prof\.ª?|Dra?\.|Eng\.|Psic\.)\s*/i, ''),
    status: new Date(t.data) >= new Date() ? 'Em treinamento' : 'Presente',
    treinamentoId: t.id
  }));

  const equipePadrao = [
    { nome: 'Ana Clara', status: 'Presente' },
    { nome: 'Lucas Mendes', status: 'Presente' },
    { nome: 'Mariana Costa', status: 'Em treinamento' },
    { nome: 'Rafael Souza', status: 'Ausente' },
    { nome: 'Beatriz Lima', status: 'Presente' },
    { nome: 'Gabriel Rocha', status: 'Presente' },
    { nome: 'Camila Alves', status: 'Em treinamento' },
    { nome: 'Thiago Nunes', status: 'Presente' }
  ];

  const listaPessoas = [];
  const nomesVistos = new Set();

  for (const p of [...instrutoresBanco, ...equipePadrao]) {
    if (!nomesVistos.has(p.nome) && listaPessoas.length < 8) {
      nomesVistos.add(p.nome);
      listaPessoas.push(p);
    }
  }
%>

<% if (erro) { %>
  <div class="alert alert-error">
    <strong>Atenção:</strong> <%= erro %>
  </div>
<% } %>

<!-- Seção Hero Centralizada -->
<section class="hero-greeting">
  <h1 class="hero-main-title">
    <span class="greeting-white">Olá, Keren.</span>
    <span class="greeting-gradient">Como está seu time hoje?</span>
  </h1>

  <!-- Barra de Comando / Busca Rápida -->
  <form action="/treinamentos" method="GET" class="command-bar">
    <input
      type="text"
      name="busca"
      class="command-input"
      placeholder="Pesquisar treinamento, consultar instrutor, agendar capacitação..."
      aria-label="Pesquisar ou agendar treinamento"
    />
    <div class="command-actions">
      <button type="button" class="command-btn-ghost" data-action="abrir-modal-criar" title="Cadastrar novo treinamento">
        + Novo
      </button>
      <button type="submit" class="command-btn-go">
        Ir
      </button>
    </div>
  </form>
</section>

<!-- Grid Principal de 3 Colunas (Pulso da Equipe | Hoje | Precisa de Atenção) -->
<section class="bento-grid-3" aria-label="Painel Principal">
  <!-- Card 1: Pulso da equipe (Donut Chart + Proporções) -->
  <article class="bento-card">
    <h2 class="bento-card-title">Pulso da equipe</h2>

    <div class="donut-wrapper">
      <div class="donut-chart">
        <div class="donut-hole">
          <strong class="donut-number">[<%= pad2(indicadores.totalTreinamentos) %>]</strong>
          <span class="donut-unit">treinamentos</span>
        </div>
      </div>
    </div>

    <ul class="pulse-legend">
      <li class="pulse-legend-item">
        <div class="legend-left">
          <span class="legend-dot dot-lavender"></span>
          <span>Cadastrados (Total)</span>
        </div>
        <strong class="legend-val">[<%= pad2(indicadores.totalTreinamentos) %>]</strong>
      </li>
      <li class="pulse-legend-item">
        <div class="legend-left">
          <span class="legend-dot dot-mint"></span>
          <span>Em treinamento (Próximos)</span>
        </div>
        <strong class="legend-val">[<%= pad2(indicadores.proximosCount) %>]</strong>
      </li>
      <li class="pulse-legend-item">
        <div class="legend-left">
          <span class="legend-dot dot-coral"></span>
          <span>Realizados (Concluídos)</span>
        </div>
        <strong class="legend-val">[<%= pad2(indicadores.realizadosCount) %>]</strong>
      </li>
    </ul>

    <p class="pulse-caption">
      Carga horária total acumulada: <strong>[<%= pad2(indicadores.totalHoras) %>h]</strong>
    </p>
  </article>

  <!-- Card 2: Hoje / Cronograma de Treinamentos -->
  <article class="bento-card">
    <div class="bento-card-header-inline">
      <h2 class="bento-card-title">Hoje · <%= dataHojeFormatada %></h2>
      <button type="button" class="btn-inline-add" data-action="abrir-modal-criar">+ Agendar</button>
    </div>

    <% if (indicadores.todosTreinamentos && indicadores.todosTreinamentos.length > 0) { %>
      <ul class="timeline-list">
        <% indicadores.todosTreinamentos.slice(0, 5).forEach((item) => { %>
          <li class="timeline-item">
            <span class="timeline-time">[<%= String(item.cargaHoraria).padStart(2, '0') %>:00h]</span>
            <a href="/treinamentos/<%= item.id %>" class="timeline-title" title="Ver detalhes de <%= item.titulo %>">
              <%= item.titulo %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="timeline-list">
        <div class="timeline-item">
          <span class="timeline-time">[00:00]</span>
          <span class="timeline-title text-muted">Nenhum treinamento cadastrado</span>
        </div>
      </div>
    <% } %>

    <div class="bento-card-footer-link">
      <a href="/treinamentos">Ver agenda completa de treinamentos &rarr;</a>
    </div>
  </article>

  <!-- Card 3: Precisa de atenção -->
  <article class="bento-card">
    <h2 class="bento-card-title">Precisa de atenção</h2>

    <div class="attention-stack">
      <% if (indicadores.proximosTreinamentos && indicadores.proximosTreinamentos.length > 0) {
           const prox = indicadores.proximosTreinamentos[0];
      %>
        <a href="/treinamentos/<%= prox.id %>" class="attention-item">
          <strong class="attention-item-title">Próximo treinamento agendado</strong>
          <span class="attention-item-sub">[<%= prox.titulo %>] · [<%= formatarData(prox.data) %>]</span>
        </a>
      <% } else { %>
        <div class="attention-item" data-action="abrir-modal-criar" style="cursor: pointer;">
          <strong class="attention-item-title">Sem treinamentos futuros</strong>
          <span class="attention-item-sub">[Clique para agendar] · [Data pendente]</span>
        </div>
      <% } %>

      <% if (indicadores.proximosTreinamentos && indicadores.proximosTreinamentos.length > 1) {
           const seg = indicadores.proximosTreinamentos[1];
      %>
        <a href="/treinamentos/<%= seg.id %>" class="attention-item">
          <strong class="attention-item-title">Capacitação em preparação</strong>
          <span class="attention-item-sub">[<%= seg.instrutor %>] · [<%= formatarData(seg.data) %>]</span>
        </a>
      <% } else { %>
        <a href="/treinamentos" class="attention-item">
          <strong class="attention-item-title">Meta de horas corporativas</strong>
          <span class="attention-item-sub">[<%= indicadores.totalHoras %>h acumuladas] · [<%= indicadores.totalTreinamentos %> turmas]</span>
        </a>
      <% } %>

      <% if (indicadores.ultimosRealizados && indicadores.ultimosRealizados.length > 0) {
           const ult = indicadores.ultimosRealizados[0];
      %>
        <a href="/treinamentos/<%= ult.id %>" class="attention-item">
          <strong class="attention-item-title">Treinamento concluído</strong>
          <span class="attention-item-sub">[<%= ult.titulo %>] · [<%= formatarData(ult.data) %>]</span>
        </a>
      <% } else { %>
        <a href="/treinamentos" class="attention-item">
          <strong class="attention-item-title">Treinamento sem presença</strong>
          <span class="attention-item-sub">[Título] · [data]</span>
        </a>
      <% } %>
    </div>
  </article>
</section>

<!-- Card Largo: Pessoas (8 Avatares Pastéis Coloridos) -->
<section id="secao-pessoas" class="bento-card people-section">
  <div class="bento-card-header-inline">
    <h2 class="bento-card-title">Pessoas</h2>
    <span class="bento-subtle-tag">Instrutores &amp; Participantes em Capacitação</span>
  </div>

  <div class="people-grid">
    <% listaPessoas.forEach((pessoa, idx) => { 
         const inicial = pessoa.nome ? pessoa.nome.trim().charAt(0).toUpperCase() : 'N';
         const classeCor = coresAvatares[idx % coresAvatares.length];
    %>
      <div class="person-item">
        <% if (pessoa.treinamentoId) { %>
          <a href="/treinamentos/<%= pessoa.treinamentoId %>" class="person-avatar <%= classeCor %>" title="Ver treinamento de <%= pessoa.nome %>">
            <%= inicial %>
          </a>
        <% } else { %>
          <div class="person-avatar <%= classeCor %>">
            <%= inicial %>
          </div>
        <% } %>
        <strong class="person-name"><%= pessoa.nome %></strong>
        <span class="person-status"><%= pessoa.status %></span>
      </div>
    <% }) %>
  </div>
</section>

<!-- Quadro Completo de Gestão de Treinamentos (CRUD Direto no Dashboard) -->
<section class="bento-card crud-section">
  <div class="crud-section-header">
    <div>
      <h2 class="bento-card-title" style="margin-bottom: 4px;">Gestão de Treinamentos Cadastrados</h2>
      <p class="bento-subtle-tag">
        Gerencie os treinamentos do banco de dados MySQL (Cadastrar, Consultar, Editar e Excluir)
      </p>
    </div>
    <div class="crud-header-actions">
      <a href="/treinamentos" class="btn btn-secondary btn-sm">Pesquisar / Filtrar</a>
      <button type="button" class="btn btn-primary btn-sm" data-action="abrir-modal-criar">
        + Novo Treinamento
      </button>
    </div>
  </div>

  <% if (indicadores.todosTreinamentos && indicadores.todosTreinamentos.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Treinamento</th>
            <th>Instrutor(a)</th>
            <th>Data</th>
            <th>Carga Horária</th>
            <th>Status</th>
            <th class="text-right">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% indicadores.todosTreinamentos.forEach((t, index) => {
               const statusObj = obterStatusTreinamento(t.data);
               const corAvatar = coresAvatares[index % coresAvatares.length];
          %>
            <tr>
              <td>
                <div class="table-primary-cell">
                  <a href="/treinamentos/<%= t.id %>" class="table-title-link"><%= t.titulo %></a>
                  <span class="table-desc-preview"><%= t.descricao || 'Sem descrição complementar.' %></span>
                </div>
              </td>
              <td>
                <div class="instructor-cell">
                  <span class="instructor-avatar <%= corAvatar %>"><%= t.instrutor.charAt(0).toUpperCase() %></span>
                  <span><%= t.instrutor %></span>
                </div>
              </td>
              <td><span class="table-date">[<%= formatarData(t.data) %>]</span></td>
              <td><span class="workload-pill">[<%= pad2(t.cargaHoraria) %>h]</span></td>
              <td>
                <span class="badge <%= statusObj.classe %>"><%= statusObj.rotulo %></span>
              </td>
              <td class="text-right">
                <div class="action-buttons">
                  <a href="/treinamentos/<%= t.id %>" class="btn-action view" title="Consultar detalhes">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </a>
                  <button
                    type="button"
                    class="btn-action edit"
                    title="Editar treinamento"
                    data-action="abrir-modal-editar"
                    data-id="<%= t.id %>"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="btn-action delete"
                    title="Excluir treinamento"
                    data-action="abrir-modal-excluir"
                    data-id="<%= t.id %>"
                    data-titulo="<%= t.titulo %>"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <h4>Nenhum treinamento cadastrado ainda</h4>
      <p>Comece agendando o primeiro treinamento corporativo da equipe.</p>
      <button type="button" class="btn btn-primary" data-action="abrir-modal-criar">
        + Cadastrar Primeiro Treinamento
      </button>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
