      </main>

      <footer class="app-footer">
        <div class="footer-content">
          <span><strong>TalentFlow</strong> — Sistema Corporativo de Gestão de Treinamentos</span>
          <span>Desenvolvido com Node.js, Express, Prisma ORM, MySQL e EJS</span>
        </div>
      </footer>
    </div>
  </div>

  <!-- Modal / Side Panel de Cadastro e Edição de Treinamento -->
  <div id="modalTreinamento" class="modal-backdrop" aria-hidden="true">
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modalTreinamentoTitulo">
      <div class="modal-header">
        <div>
          <span id="modalTreinamentoSubtitulo" class="modal-eyebrow">GESTÃO DE CAPACITAÇÃO</span>
          <h2 id="modalTreinamentoTitulo" class="modal-title">Novo Treinamento</h2>
        </div>
        <button type="button" class="btn-icon" data-action="fechar-modal-treinamento" aria-label="Fechar janela">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <form id="formTreinamento" class="modal-form" novalidate>
        <input type="hidden" id="treinamentoId" name="id" value="" />

        <div id="formAlertaErro" class="alert alert-error hidden" role="alert"></div>

        <div class="form-group">
          <label for="inputTitulo" class="form-label">Título do Treinamento <span class="required">*</span></label>
          <input
            type="text"
            id="inputTitulo"
            name="titulo"
            class="form-control"
            placeholder="Ex.: Excel Avançado para Análise de Dados"
            maxlength="150"
            required
          />
          <span class="form-hint">Mínimo de 3 e máximo de 150 caracteres.</span>
        </div>

        <div class="form-group">
          <label for="inputInstrutor" class="form-label">Instrutor(a) Responsável <span class="required">*</span></label>
          <input
            type="text"
            id="inputInstrutor"
            name="instrutor"
            class="form-control"
            placeholder="Ex.: Prof.ª Ana Carolina Mendes"
            maxlength="120"
            required
          />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="inputData" class="form-label">Data de Realização <span class="required">*</span></label>
            <input
              type="date"
              id="inputData"
              name="data"
              class="form-control"
              required
            />
          </div>

          <div class="form-group">
            <label for="inputCargaHoraria" class="form-label">Carga Horária (horas) <span class="required">*</span></label>
            <input
              type="number"
              id="inputCargaHoraria"
              name="cargaHoraria"
              class="form-control"
              placeholder="Ex.: 16"
              min="1"
              max="1000"
              step="1"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="inputDescricao" class="form-label">Descrição e Conteúdo Programático</label>
          <textarea
            id="inputDescricao"
            name="descricao"
            class="form-control form-textarea"
            rows="4"
            placeholder="Descreva os objetivos, público-alvo e principais tópicos abordados no treinamento..."
          ></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-action="fechar-modal-treinamento">
            Cancelar
          </button>
          <button type="submit" id="btnSalvarTreinamento" class="btn btn-primary">
            <span id="btnSalvarTexto">Cadastrar Treinamento</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de Confirmação de Exclusão -->
  <div id="modalExclusao" class="modal-backdrop" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modalExclusaoTitulo">
      <div class="modal-dialog-icon danger">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
      </div>
      <h3 id="modalExclusaoTitulo" class="modal-dialog-title">Confirmar Exclusão</h3>
      <p class="modal-dialog-text">
        Tem certeza que deseja excluir o treinamento <strong id="exclusaoNomeTreinamento"></strong>?
        Esta ação removerá o registro permanentemente do banco de dados.
      </p>
      <input type="hidden" id="exclusaoTreinamentoId" value="" />
      <div class="modal-dialog-actions">
        <button type="button" class="btn btn-secondary" data-action="fechar-modal-exclusao">
          Cancelar
        </button>
        <button type="button" id="btnConfirmarExclusao" class="btn btn-danger">
          Sim, Excluir
        </button>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/treinamentos.js"></script>
</body>
</html>
