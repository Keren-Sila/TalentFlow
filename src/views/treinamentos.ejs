<%- include('partials/header') %>

<% if (erro) { %>
  <div class="alert alert-error">
    <strong>Atenção:</strong> <%= erro %>
  </div>
<% } %>

<!-- Mini Resumo na Página de Listagem -->
<section class="summary-strip">
  <div class="summary-pill">
    <span class="summary-pill-label">Total</span>
    <strong class="summary-pill-value"><%= indicadores.totalTreinamentos %></strong>
  </div>
  <div class="summary-pill">
    <span class="summary-pill-label">Carga Horária Total</span>
    <strong class="summary-pill-value"><%= indicadores.totalHoras %>h</strong>
  </div>
  <div class="summary-pill">
    <span class="summary-pill-label">Próximos</span>
    <strong class="summary-pill-value text-purple"><%= indicadores.proximosCount %></strong>
  </div>
  <div class="summary-pill">
    <span class="summary-pill-label">Realizados</span>
    <strong class="summary-pill-value text-emerald"><%= indicadores.realizadosCount %></strong>
  </div>
</section>

<!-- Barra de Pesquisa e Filtros -->
<section class="card filter-bar-card">
  <form id="formFiltros" action="/treinamentos" method="GET" class="filter-form">
    <div class="search-input-wrapper">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="inputBusca"
        name="busca"
        value="<%= filtros.busca %>"
        class="form-control search-input"
        placeholder="Pesquisar por título, instrutor ou descrição..."
        aria-label="Pesquisar treinamentos"
      />
    </div>

    <div class="filter-controls">
      <div class="filter-select-group">
        <label for="selectStatus" class="sr-only">Status</label>
        <select id="selectStatus" name="status" class="form-control filter-select">
          <option value="todos" <%= filtros.status === 'todos' ? 'selected' : '' %>>Status: Todos</option>
          <option value="proximos" <%= filtros.status === 'proximos' ? 'selected' : '' %>>Apenas Próximos (Agendados)</option>
          <option value="realizados" <%= filtros.status === 'realizados' ? 'selected' : '' %>>Apenas Realizados (Concluídos)</option>
        </select>
      </div>

      <div class="filter-select-group">
        <label for="selectOrdenar" class="sr-only">Ordenar por</label>
        <select id="selectOrdenar" name="ordenar" class="form-control filter-select">
          <option value="data_asc" <%= filtros.ordenar === 'data_asc' ? 'selected' : '' %>>Ordenar: Data (Mais próximos)</option>
          <option value="data_desc" <%= filtros.ordenar === 'data_desc' ? 'selected' : '' %>>Ordenar: Data (Mais recentes)</option>
          <option value="titulo_asc" <%= filtros.ordenar === 'titulo_asc' ? 'selected' : '' %>>Ordenar: Título (A - Z)</option>
          <option value="carga_desc" <%= filtros.ordenar === 'carga_desc' ? 'selected' : '' %>>Ordenar: Maior Carga Horária</option>
        </select>
      </div>

      <button type="submit" class="btn btn-secondary">
        Filtrar
      </button>

      <% if (filtros.busca || (filtros.status && filtros.status !== 'todos') || (filtros.ordenar && filtros.ordenar !== 'data_asc')) { %>
        <a href="/treinamentos" class="btn btn-ghost" title="Limpar filtros">
          Limpar
        </a>
      <% } %>
    </div>
  </form>
</section>

<!-- Tabela Principal de Treinamentos -->
<section class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title">Catálogo de Treinamentos</h2>
      <p class="card-subtitle">
        Exibindo <strong id="contadorRegistros"><%= treinamentos.length %></strong>
        <%= treinamentos.length === 1 ? 'treinamento encontrado' : 'treinamentos encontrados' %>
      </p>
    </div>
    <button type="button" class="btn btn-primary" data-action="abrir-modal-criar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>Cadastrar Treinamento</span>
    </button>
  </div>

  <% if (treinamentos && treinamentos.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table" id="tabelaTreinamentos">
        <thead>
          <tr>
            <th>ID</th>
            <th>Título &amp; Descrição</th>
            <th>Instrutor(a)</th>
            <th>Data</th>
            <th>Carga Horária</th>
            <th>Status</th>
            <th class="text-right">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% treinamentos.forEach((t) => {
               const statusObj = obterStatusTreinamento(t.data);
          %>
            <tr
              class="training-row"
              data-titulo="<%= t.titulo.toLowerCase() %>"
              data-instrutor="<%= t.instrutor.toLowerCase() %>"
              data-status="<%= statusObj.classe === 'badge-upcoming' ? 'proximos' : 'realizados' %>"
            >
              <td><span class="id-badge">#<%= t.id %></span></td>
              <td>
                <div class="table-primary-cell">
                  <a href="/treinamentos/<%= t.id %>" class="table-title-link"><%= t.titulo %></a>
                  <span class="table-desc-preview"><%= t.descricao || 'Sem descrição cadastrada.' %></span>
                </div>
              </td>
              <td>
                <div class="instructor-cell">
                  <span class="instructor-avatar"><%= t.instrutor.charAt(0).toUpperCase() %></span>
                  <span><%= t.instrutor %></span>
                </div>
              </td>
              <td><span class="table-date"><%= formatarData(t.data) %></span></td>
              <td><span class="workload-pill"><%= t.cargaHoraria %>h</span></td>
              <td>
                <span class="badge <%= statusObj.classe %>"><%= statusObj.rotulo %></span>
              </td>
              <td class="text-right">
                <div class="action-buttons">
                  <a href="/treinamentos/<%= t.id %>" class="btn-action view" title="Ver detalhes completos">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </a>
                  <button
                    type="button"
                    class="btn-action edit"
                    title="Editar treinamento"
                    data-action="abrir-modal-editar"
                    data-id="<%= t.id %>"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="btn-action delete"
                    title="Excluir treinamento"
                    data-action="abrir-modal-excluir"
                    data-id="<%= t.id %>"
                    data-titulo="<%= t.titulo %>"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h4>Nenhum treinamento encontrado</h4>
      <p>Não encontramos treinamentos com os critérios informados. Tente limpar os filtros ou cadastre um novo treinamento.</p>
      <div class="empty-state-actions">
        <a href="/treinamentos" class="btn btn-secondary">Limpar Filtros</a>
        <button type="button" class="btn btn-primary" data-action="abrir-modal-criar">
          + Novo Treinamento
        </button>
      </div>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
