<%- include('partials/header') %>

<%
  const pad2 = (n) => String(n ?? 0).padStart(2, '0');
  const coresAvatares = [
    'avatar-lavender',
    'avatar-mint',
    'avatar-coral',
    'avatar-yellow',
    'avatar-blue',
    'avatar-lilac',
    'avatar-green',
    'avatar-orange'
  ];
%>

<% if (erro) { %>
  <div class="alert alert-error">
    <strong>Atenção:</strong> <%= erro %>
  </div>
<% } %>

<!-- Cabeçalho da Página de Treinamentos -->
<section class="hero-greeting hero-compact">
  <h1 class="hero-main-title">
    <span class="greeting-white">Treinamentos.</span>
    <span class="greeting-gradient">Capacitação e agenda do time</span>
  </h1>

  <!-- Barra de Pesquisa e Filtros no Estilo Command Bar -->
  <form id="formFiltros" action="/treinamentos" method="GET" class="command-bar command-bar-filters">
    <input
      type="search"
      id="inputBusca"
      name="busca"
      value="<%= filtros.busca %>"
      class="command-input"
      placeholder="Pesquisar por título, instrutor ou conteúdo..."
      aria-label="Pesquisar treinamentos"
    />

    <div class="command-actions">
      <select id="selectStatus" name="status" class="command-select" aria-label="Filtrar por status">
        <option value="todos" <%= filtros.status === 'todos' ? 'selected' : '' %>>Status: Todos</option>
        <option value="proximos" <%= filtros.status === 'proximos' ? 'selected' : '' %>>Agendados (Próximos)</option>
        <option value="realizados" <%= filtros.status === 'realizados' ? 'selected' : '' %>>Realizados (Concluídos)</option>
      </select>

      <select id="selectOrdenar" name="ordenar" class="command-select" aria-label="Ordenar por">
        <option value="data_asc" <%= filtros.ordenar === 'data_asc' ? 'selected' : '' %>>Data (Mais próximos)</option>
        <option value="data_desc" <%= filtros.ordenar === 'data_desc' ? 'selected' : '' %>>Data (Mais recentes)</option>
        <option value="titulo_asc" <%= filtros.ordenar === 'titulo_asc' ? 'selected' : '' %>>Título (A-Z)</option>
        <option value="carga_desc" <%= filtros.ordenar === 'carga_desc' ? 'selected' : '' %>>Maior Carga Horária</option>
      </select>

      <% if (filtros.busca || (filtros.status && filtros.status !== 'todos') || (filtros.ordenar && filtros.ordenar !== 'data_asc')) { %>
        <a href="/treinamentos" class="command-btn-ghost" title="Limpar filtros">Limpar</a>
      <% } %>

      <button type="submit" class="command-btn-go">Ir</button>
    </div>
  </form>
</section>

<!-- Faixa de Indicadores Rápidos -->
<section class="summary-strip">
  <div class="bento-mini-card">
    <span class="legend-dot dot-lavender"></span>
    <span class="summary-pill-label">Cadastrados</span>
    <strong class="summary-pill-value"><%= pad2(indicadores.totalTreinamentos) %></strong>
  </div>
  <div class="bento-mini-card">
    <span class="legend-dot dot-mint"></span>
    <span class="summary-pill-label">Agendados</span>
    <strong class="summary-pill-value text-mint"><%= pad2(indicadores.proximosCount) %></strong>
  </div>
  <div class="bento-mini-card">
    <span class="legend-dot dot-coral"></span>
    <span class="summary-pill-label">Realizados</span>
    <strong class="summary-pill-value text-coral"><%= pad2(indicadores.realizadosCount) %></strong>
  </div>
  <div class="bento-mini-card">
    <span class="legend-dot dot-yellow"></span>
    <span class="summary-pill-label">Total de Horas</span>
    <strong class="summary-pill-value"><%= indicadores.totalHoras %>h</strong>
  </div>
</section>

<!-- Tabela Principal de Treinamentos -->
<section class="bento-card crud-section">
  <div class="crud-section-header">
    <div>
      <h2 class="bento-card-title" style="margin-bottom: 4px;">Catálogo de Treinamentos</h2>
      <p class="bento-subtle-tag">
        Exibindo <strong id="contadorRegistros"><%= treinamentos.length %></strong>
        <%= treinamentos.length === 1 ? 'registro encontrado' : 'registros encontrados' %>
      </p>
    </div>
    <button type="button" class="btn btn-primary" data-action="abrir-modal-criar">
      + Cadastrar Treinamento
    </button>
  </div>

  <% if (treinamentos && treinamentos.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table" id="tabelaTreinamentos">
        <thead>
          <tr>
            <th>ID</th>
            <th>Treinamento</th>
            <th>Instrutor(a)</th>
            <th>Data</th>
            <th>Carga Horária</th>
            <th>Status</th>
            <th class="text-right">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% treinamentos.forEach((t, idx) => {
               const statusObj = obterStatusTreinamento(t.data);
               const corAvatar = coresAvatares[idx % coresAvatares.length];
          %>
            <tr class="training-row">
              <td><span class="id-badge">#<%= pad2(t.id) %></span></td>
              <td>
                <div class="table-primary-cell">
                  <a href="/treinamentos/<%= t.id %>" class="table-title-link"><%= t.titulo %></a>
                  <span class="table-desc-preview"><%= t.descricao || 'Sem descrição cadastrada.' %></span>
                </div>
              </td>
              <td>
                <div class="instructor-cell">
                  <span class="instructor-avatar <%= corAvatar %>"><%= t.instrutor.charAt(0).toUpperCase() %></span>
                  <span><%= t.instrutor %></span>
                </div>
              </td>
              <td><span class="table-date"><%= formatarData(t.data) %></span></td>
              <td><span class="workload-pill"><%= t.cargaHoraria %>h</span></td>
              <td>
                <span class="badge <%= statusObj.classe %>"><%= statusObj.rotulo %></span>
              </td>
              <td class="text-right">
                <div class="action-buttons">
                  <a href="/treinamentos/<%= t.id %>" class="btn-action view" title="Ver detalhes completos">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </a>
                  <button
                    type="button"
                    class="btn-action edit"
                    title="Editar treinamento"
                    data-action="abrir-modal-editar"
                    data-id="<%= t.id %>"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="btn-action delete"
                    title="Excluir treinamento"
                    data-action="abrir-modal-excluir"
                    data-id="<%= t.id %>"
                    data-titulo="<%= t.titulo %>"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <h4>Nenhum treinamento encontrado</h4>
      <p>Não encontramos treinamentos com os critérios informados. Limpe os filtros ou cadastre um novo treinamento.</p>
      <div class="empty-state-actions">
        <a href="/treinamentos" class="btn btn-secondary">Limpar Filtros</a>
        <button type="button" class="btn btn-primary" data-action="abrir-modal-criar">
          + Novo Treinamento
        </button>
      </div>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
